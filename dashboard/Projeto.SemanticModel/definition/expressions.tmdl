expression fx = ```
		(files as binary ) as table => 
		let
		    arquivo = files,
		    csvImport = Csv.Document(files,[Delimiter=",", Columns=38, Encoding=1252, QuoteStyle=QuoteStyle.None]),
		    head = Table.PromoteHeaders(csvImport, [PromoteAllScalars=true]),
		    removeColumns = Table.RemoveColumns(head,{"NU_ANO"}),
		    typechange = Table.TransformColumnTypes( removeColumns ,{{"DT_ENCERRA", type date}, {"DT_NOTIFIC", type date}})
		in
		    typechange
		```
